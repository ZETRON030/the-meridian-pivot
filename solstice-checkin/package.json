{
  "name": "solstice-checkin",
  "version": "1.0.0",
  "private": true,
  "description": "Solstice Events Co. asynchronous conference check-in kiosk",
  "workspaces": [
    "apps/kiosk",
    "apps/api",
    "workers/vendor-checkin-worker",
    "mock-vendor"
  ],
  "scripts": {
    "dev:kiosk": "npm run dev --workspace=apps/kiosk",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:worker": "npm run start:dev --workspace=workers/vendor-checkin-worker",
    "dev:vendor": "npm run start:dev --workspace=mock-vendor",

    "build": "npm run build --workspaces",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",

    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",

    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "amqplib": "^0.10.4",
    "axios": "^1.7.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/amqplib": "^0.10.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jest": "^29.7.0",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}