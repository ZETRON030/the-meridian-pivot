# ============================================================
# SOLSTICE EVENTS CO.
# Asynchronous Check-In Kiosk
# Environment Configuration Template
# ============================================================

# ============================================================
# APPLICATION
# ============================================================

NODE_ENV=development
API_PORT=3000
KIOSK_PORT=5173

# Public API URL used by the kiosk frontend
VITE_API_BASE_URL=http://localhost:3000


# ============================================================
# DATABASE - POSTGRESQL
# ============================================================

DATABASE_URL=postgresql://solstice_user:solstice_password@localhost:5432/solstice_checkin?schema=public


# ============================================================
# RABBITMQ
# ============================================================

RABBITMQ_URL=amqp://solstice_user:solstice_password@localhost:5672

RABBITMQ_EXCHANGE=solstice.checkin
RABBITMQ_QUEUE=solstice.checkin.vendor
RABBITMQ_ROUTING_KEY=checkin.requested

# Dead-letter configuration
RABBITMQ_DLQ_EXCHANGE=solstice.checkin.dlx
RABBITMQ_DLQ=solstice.checkin.vendor.dlq
RABBITMQ_DLQ_ROUTING_KEY=checkin.failed


# ============================================================
# VENDOR ASYNCHRONOUS API
# ============================================================

# Replace these placeholders with values supplied by the
# actual Solstice Events vendor.
VENDOR_API_BASE_URL=https://vendor-sandbox.example.com
VENDOR_ASYNC_CHECKIN_PATH=/api/check-ins

# Vendor authentication
VENDOR_AUTH_TYPE=api-key
VENDOR_API_KEY=replace-with-vendor-api-key
VENDOR_API_SECRET=replace-with-vendor-api-secret

# Request timeout in milliseconds
VENDOR_REQUEST_TIMEOUT_MS=10000


# ============================================================
# VENDOR WEBHOOK
# ============================================================

# Secret supplied by the vendor for webhook verification.
# The exact authentication mechanism must match the vendor's
# production webhook specification.
VENDOR_WEBHOOK_SECRET=replace-with-vendor-webhook-secret

# Expected webhook path exposed by our API
VENDOR_WEBHOOK_PATH=/api/webhooks/vendor


# ============================================================
# ASYNCHRONOUS CHECK-IN PROCESSING
# ============================================================

# Maximum number of vendor submission retries
VENDOR_MAX_RETRIES=3

# Delay between retry attempts in milliseconds
VENDOR_RETRY_DELAY_MS=5000

# Maximum time the kiosk should remain in PENDING state
CHECKIN_PENDING_TIMEOUT_MS=120000

# Kiosk polling interval while a check-in is PENDING
CHECKIN_STATUS_POLL_INTERVAL_MS=2000


# ============================================================
# SECURITY
# ============================================================

# Used for application-level security where required.
# Generate a strong random value for real deployments.
APP_SECRET=replace-with-a-long-random-secret


# ============================================================
# CORS
# ============================================================

CORS_ORIGIN=http://localhost:5173


# ============================================================
# MOCK VENDOR - DEVELOPMENT/TESTING ONLY
# ============================================================

MOCK_VENDOR_ENABLED=true
MOCK_VENDOR_PORT=4000

# Mock vendor behavior
MOCK_VENDOR_AUTO_CONFIRM=true
MOCK_VENDOR_CONFIRMATION_DELAY_MS=3000


# ============================================================
# LOGGING
# ============================================================

LOG_LEVEL=info